# POK-Valheim Configuration
# Copy to .env and customize before starting: cp .env.example .env

# Port for the POK-Valheim Web Dashboard
WEB_PORT=8080

# Your Linux server's LAN IP or public domain/IP (shown in one-click Copy Connect buttons)
PUBLIC_HOST=

# Timezone (e.g. America/Los_Angeles, America/New_York, Europe/London, UTC)
TZ=UTC

# Optional: Absolute path on your Linux host for persistent saves, configs, and backups.
# Leave blank to use ./data (auto-discovered from Docker mount).
HOST_DATA_DIR=

# Web UI Authentication
POK_AUTH_ENABLED=true
POK_ADMIN_USER=admin
POK_ADMIN_PASS=pokvalheim
POK_JWT_SECRET=change-this-to-a-long-random-secret-string
